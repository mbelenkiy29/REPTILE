# Countersign environment. Copy to .env.local (local) or set in Vercel / Fly (deployed). Never commit real values.
# Every value comes from an account YOU create; see replica/backend.md for the steps.

# ── Core ─────────────────────────────────────────────────────────────
# Postgres 16 with the pgvector, citext and pgcrypto extensions (Neon, Supabase, or local).
DATABASE_URL=
# Database pool size per process (web default 10).
DATABASE_POOL=
# Public URL of the web app, no trailing slash (https://app.example.com). Used in emails, GitHub comments, redirects.
APP_URL=
# Random 32+ byte secret for Auth.js sessions and signed GitHub install state: `openssl rand -base64 32`.
AUTH_SECRET=

# ── Sign-in ──────────────────────────────────────────────────────────
# Google OAuth client (optional). Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email sign-in links and transactional email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# ── GitHub App (your own app; it also provides "Sign in with GitHub") ─
GITHUB_APP_ID=
# The app's URL name, as in github.com/apps/<slug>. Also the @mention that triggers reviews.
GITHUB_APP_SLUG=
# PEM private key. Newlines may be written as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Models ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5.
REVIEW_MODEL=
VOYAGE_API_KEY=
# Optional override; default voyage-code-3 (1024 dimensions, matches the schema).
EMBED_MODEL=

# ── Billing (Stripe, TEST mode until /replica-deploy) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flat pricing: one licensed per-seat price, nothing metered (see replica/launch/pricing.md).
# The monthly seat price id, and optionally the annual one (leave empty to offer monthly only).
STRIPE_PRICE_SEAT=
STRIPE_PRICE_SEAT_ANNUAL=
# Display prices in cents a seat a month (must match the Stripe prices). Defaults 2400 and 2000 (annual, per month).
PRICE_SEAT_CENTS=
PRICE_SEAT_ANNUAL_CENTS=

# ── Error tracking (Sentry; optional, off when empty) ────────────────
# Server and worker DSN, and the browser one (can be the same DSN). Environment defaults to Vercel's or NODE_ENV.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ── Local development only (refused unless APP_URL is http://localhost) ─
# Sign in as a seeded user without a provider.
AUTH_DEV_LOGIN=
# Fake GitHub (no app needed) and a fake model/embedder (no keys needed).
GITHUB_FAKE=
REVIEW_FAKE_AI=
# Show /design and the dev data panel in a production build.
SHOW_DESIGN=
# Tests: a separate database whose name contains "test" (it is wiped on every run).
TEST_DATABASE_URL=
