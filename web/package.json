{
  "name": "reptile-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens": "node ../replica/design/build-tokens.mjs src/styles",
    "contrast": "python3 ../replica/design/contrast.py ../replica/design/tokens.json && python3 ../replica/design/contrast.py ../replica/design/tokens.dark.json",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/design-check.mjs",
    "test": "vitest run",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts --reset",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@localhost:5432/reptile_test} vitest run",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^12.36.0",
    "picomatch": "^4.0.7",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
